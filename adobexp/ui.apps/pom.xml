<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.adobexp</groupId>
        <artifactId>adobexp-aem-quickstart-parent</artifactId>
        <version>2.0.7</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>adobexp-aem-quickstart.ui.apps</artifactId>
    <packaging>content-package</packaging>
    <name>AdobeXP - AEM Quickstart UI apps</name>
    <description>UI apps package for AdobeXP - AEM Quickstart</description>

    <build>
        <sourceDirectory>src/main/content/jcr_root</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.jackrabbit</groupId>
                <artifactId>filevault-package-maven-plugin</artifactId>
                <configuration>
                    <properties>
                        <cloudManagerTarget>none</cloudManagerTarget>
                    </properties>
                    <group>com.adobexp</group>
                    <name>adobexp-aem-quickstart.ui.apps</name>
                    <packageType>application</packageType>
                    <repositoryStructurePackages>
                        <repositoryStructurePackage>
                            <groupId>com.adobexp</groupId>
                            <artifactId>adobexp-aem-quickstart.ui.apps.structure</artifactId>
                        </repositoryStructurePackage>
                    </repositoryStructurePackages>
                    <validatorsSettings>
                        <jackrabbit-filter>
                            <isDisabled>true</isDisabled>
                        </jackrabbit-filter>
                    </validatorsSettings>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.day.jcr.vault</groupId>
                <artifactId>content-package-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <verbose>true</verbose>
                    <failOnError>true</failOnError>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.sling</groupId>
                <artifactId>htl-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>validate-htl-scripts</id>
                        <goals>
                            <goal>validate</goal>
                        </goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <generateJavaClasses>true</generateJavaClasses>
                            <generatedJavaClassesPrefix>org.apache.sling.scripting.sightly</generatedJavaClassesPrefix>
                            <sourceDirectory>${project.build.sourceDirectory}</sourceDirectory>
                            <!--
                              We keep failOnWarnings=true (in the parent POM), so we must explicitly allow the
                              HTL "@" option names used in this codebase (template parameters + data-sly-resource options).
                            -->
                            <allowedExpressionOptions>
                                <allowedExpressionOption>action</allowedExpressionOption>
                                <allowedExpressionOption>appendPath</allowedExpressionOption>
                                <allowedExpressionOption>async</allowedExpressionOption>
                                <allowedExpressionOption>categories</allowedExpressionOption>
                                <allowedExpressionOption>classAppend</allowedExpressionOption>
                                <allowedExpressionOption>clientLibCategories</allowedExpressionOption>
                                <allowedExpressionOption>clientLibCategoriesJsHead</allowedExpressionOption>
                                <allowedExpressionOption>components</allowedExpressionOption>
                                <allowedExpressionOption>container</allowedExpressionOption>
                                <allowedExpressionOption>context</allowedExpressionOption>
                                <allowedExpressionOption>crossorigin</allowedExpressionOption>
                                <allowedExpressionOption>cssClassName</allowedExpressionOption>
                                <allowedExpressionOption>decoration</allowedExpressionOption>
                                <allowedExpressionOption>decorationTagName</allowedExpressionOption>
                                <allowedExpressionOption>defer</allowedExpressionOption>
                                <allowedExpressionOption>designPath</allowedExpressionOption>
                                <allowedExpressionOption>emptyTextAppend</allowedExpressionOption>
                                <allowedExpressionOption>format</allowedExpressionOption>
                                <allowedExpressionOption>hasCloudconfigSupport</allowedExpressionOption>
                                <allowedExpressionOption>internalUrl</allowedExpressionOption>
                                <allowedExpressionOption>isEmpty</allowedExpressionOption>
                                <allowedExpressionOption>item</allowedExpressionOption>
                                <allowedExpressionOption>join</allowedExpressionOption>
                                <allowedExpressionOption>media</allowedExpressionOption>
                                <allowedExpressionOption>onload</allowedExpressionOption>
                                <allowedExpressionOption>page</allowedExpressionOption>
                                <allowedExpressionOption>path</allowedExpressionOption>
                                <allowedExpressionOption>pwa</allowedExpressionOption>
                                <allowedExpressionOption>redirectTarget</allowedExpressionOption>
                                <allowedExpressionOption>resourceType</allowedExpressionOption>
                                <allowedExpressionOption>selectors</allowedExpressionOption>
                                <allowedExpressionOption>staticDesignPath</allowedExpressionOption>
                                <allowedExpressionOption>teaser</allowedExpressionOption>
                                <allowedExpressionOption>title</allowedExpressionOption>
                                <allowedExpressionOption>wcmmode</allowedExpressionOption>
                            </allowedExpressionOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>


    <!-- ====================================================================== -->
    <!-- D E P E N D E N C I E S                                                -->
    <!-- ====================================================================== -->
    <dependencies>
        <dependency>
            <groupId>com.adobexp</groupId>
            <artifactId>adobexp-aem-quickstart.core</artifactId>
            <version>${project.version}</version>
        </dependency>



        <dependency>
            <groupId>com.adobexp</groupId>
            <artifactId>adobexp-aem-quickstart.ui.apps.structure</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>


        <dependency>
            <groupId>com.adobe.aem</groupId>
            <artifactId>uber-jar</artifactId>
        </dependency>

        <dependency>
            <groupId>javax.jcr</groupId>
            <artifactId>jcr</artifactId>
        </dependency>

        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
        </dependency>


        <!-- HTL dependencies needed for the HTL Maven Plugin source code generation -->
        <dependency>
            <groupId>org.apache.sling</groupId>
            <artifactId>org.apache.sling.scripting.sightly.runtime</artifactId>
            <version>1.2.4-1.4.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
