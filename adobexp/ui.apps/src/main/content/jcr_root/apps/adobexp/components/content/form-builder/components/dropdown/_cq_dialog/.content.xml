<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Dropdown Field"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <!-- Tab 1: Field Configuration -->
                    <field
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Field"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <!-- Field Label -->
                                            <fieldLabel
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Field Label"
                                                fieldDescription="Label displayed above the dropdown"
                                                name="./fieldLabel"
                                                required="{Boolean}true"/>
                                            <!-- Field Name (for form data) -->
                                            <fieldName
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Field Name"
                                                fieldDescription="Name attribute used when submitting form data"
                                                name="./fieldName"
                                                required="{Boolean}true"/>
                                            <!-- Placeholder -->
                                            <placeholder
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Placeholder Text"
                                                fieldDescription="Placeholder text shown when nothing is selected"
                                                name="./placeholder"
                                                value="Select options..."/>
                                            <!-- Enable Search -->
                                            <enableSearch
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                fieldDescription="Enable search filter in dropdown"
                                                name="./enableSearch"
                                                text="Enable Search"
                                                checked="{Boolean}true"
                                                uncheckedValue="false"
                                                value="true"/>
                                            <!-- Field Width -->
                                            <fieldWidth
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="Field Width"
                                                fieldDescription="Width of this field in the form layout"
                                                name="./fieldWidth">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <full
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Full Width"
                                                        value="full"
                                                        selected="{Boolean}true"/>
                                                    <half
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Half Width (1/2)"
                                                        value="half"/>
                                                    <third
                                                        jcr:primaryType="nt:unstructured"
                                                        text="One Third (1/3)"
                                                        value="third"/>
                                                    <twoThirds
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Two Thirds (2/3)"
                                                        value="two-thirds"/>
                                                </items>
                                            </fieldWidth>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </field>
                    
                    <!-- Tab 2: Options -->
                    <options
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Options"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <!-- Dropdown Options Multifield -->
                                            <dropdownOptions
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                composite="{Boolean}true"
                                                fieldLabel="Dropdown Options"
                                                fieldDescription="Add options for the dropdown. Each option needs a value and display label.">
                                                <field
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                                    name="./dropdownOptions">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <!-- Option Value -->
                                                        <optionValue
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Value"
                                                            fieldDescription="The value submitted with the form (e.g., 'option-1')"
                                                            name="optionValue"
                                                            required="{Boolean}true"/>
                                                        <!-- Option Label -->
                                                        <optionLabel
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Display Label"
                                                            fieldDescription="The text shown to the user (e.g., 'Option 1')"
                                                            name="optionLabel"
                                                            required="{Boolean}true"/>
                                                        <!-- Selected by Default -->
                                                        <optionSelected
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                            fieldDescription="Pre-select this option"
                                                            name="optionSelected"
                                                            text="Selected by Default"
                                                            uncheckedValue="false"
                                                            value="true"/>
                                                    </items>
                                                </field>
                                            </dropdownOptions>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </options>
                    
                    <!-- Tab 3: Validation -->
                    <validation
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Validation"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <!-- Required -->
                                            <required
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                fieldDescription="Make this field required"
                                                name="./required"
                                                text="Required Field"
                                                uncheckedValue="false"
                                                value="true"/>
                                            <!-- Required Message -->
                                            <requiredMessage
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Required Message"
                                                fieldDescription="Error message when required field is empty"
                                                name="./requiredMessage"
                                                value="Please select at least one option"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </validation>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
