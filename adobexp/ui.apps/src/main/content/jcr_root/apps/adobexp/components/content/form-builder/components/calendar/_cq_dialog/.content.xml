<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Calendar Field"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <!-- Tab 1: Field Configuration -->
                    <field
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Field"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <!-- Field Label -->
                                            <fieldLabel
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Field Label"
                                                fieldDescription="Label displayed above the date picker"
                                                name="./fieldLabel"
                                                required="{Boolean}true"
                                                value="Date"/>
                                            <!-- Field Name (for form data) -->
                                            <fieldName
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Field Name"
                                                fieldDescription="Name attribute used when submitting form data"
                                                name="./fieldName"
                                                required="{Boolean}true"
                                                value="date"/>
                                            <!-- Field ID -->
                                            <fieldId
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Field ID"
                                                fieldDescription="Unique HTML ID for the field (optional)"
                                                name="./fieldId"/>
                                            <!-- Placeholder -->
                                            <placeholder
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Placeholder Text"
                                                fieldDescription="Placeholder text shown when no date is selected"
                                                name="./placeholder"
                                                value="Select a date"/>
                                            <!-- Helper Text -->
                                            <helperText
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Helper Text"
                                                fieldDescription="Optional helper text displayed below the field"
                                                name="./helperText"/>
                                            <!-- Field Width -->
                                            <fieldWidth
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="Field Width"
                                                fieldDescription="Width of this field in the form layout"
                                                name="./fieldWidth">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <full
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Full Width"
                                                        value="full"
                                                        selected="{Boolean}true"/>
                                                    <half
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Half Width (1/2)"
                                                        value="half"/>
                                                    <third
                                                        jcr:primaryType="nt:unstructured"
                                                        text="One Third (1/3)"
                                                        value="third"/>
                                                    <twoThirds
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Two Thirds (2/3)"
                                                        value="two-thirds"/>
                                                </items>
                                            </fieldWidth>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </field>
                    
                    <!-- Tab 2: Validation -->
                    <validation
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Validation"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <!-- Required -->
                                            <required
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                fieldDescription="Make this field required"
                                                name="./required"
                                                text="Required Field"
                                                uncheckedValue="false"
                                                value="true"/>
                                            <!-- Required Message -->
                                            <requiredMessage
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Required Message"
                                                fieldDescription="Error message when required field is empty"
                                                name="./requiredMessage"
                                                value="Please select a date"/>
                                            <!-- Error Message -->
                                            <errorMessage
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Validation Error Message"
                                                fieldDescription="Error message shown when validation fails"
                                                name="./errorMessage"
                                                value="Please select a valid date"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </validation>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
