<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Analytics Chart"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        granite:class="cmp-analytics-chart__editor"
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <contentTab
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Content"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <title
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Title"
                                                fieldDescription="Section title above the report panels"
                                                name="./title"/>
                                            <subtitle
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                fieldLabel="Subtitle"
                                                fieldDescription="Supporting text below the title"
                                                name="./subtitle"
                                                rows="{Long}3"/>
                                            <ariaLabel
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Accessible Label"
                                                fieldDescription="Screen reader label for the whole section"
                                                name="./ariaLabel"
                                                value="Analytics reports"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </contentTab>
                    <panels
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Panels"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <chartPanels
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                composite="{Boolean}true"
                                                fieldLabel="Chart Panels"
                                                fieldDescription="Add one panel per report. Each panel renders its own chart from the labels and series below.">
                                                <field
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                                    name="./chartPanels">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <panelTitle
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Panel Title"
                                                            fieldDescription="Heading of the panel, e.g. Unique visitors per day"
                                                            name="panelTitle"/>
                                                        <badge
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Badge"
                                                            fieldDescription="Short type chip shown next to the panel title, e.g. Trend"
                                                            name="badge"/>
                                                        <description
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                                                            fieldLabel="Description"
                                                            fieldDescription="Supports rich text (bold, links, inline code)"
                                                            name="description"
                                                            useFixedInlineToolbar="{Boolean}true">
                                                            <rtePlugins jcr:primaryType="nt:unstructured">
                                                                <format
                                                                    jcr:primaryType="nt:unstructured"
                                                                    features="bold,italic"/>
                                                                <links
                                                                    jcr:primaryType="nt:unstructured"
                                                                    features="modifylink,unlink"/>
                                                                <lists
                                                                    jcr:primaryType="nt:unstructured"
                                                                    features="*"/>
                                                                <misctools jcr:primaryType="nt:unstructured">
                                                                    <specialCharsConfig jcr:primaryType="nt:unstructured">
                                                                        <chars jcr:primaryType="nt:unstructured">
                                                                            <default_copyright
                                                                                jcr:primaryType="nt:unstructured"
                                                                                entity="&amp;copy;"
                                                                                name="copyright"/>
                                                                        </chars>
                                                                    </specialCharsConfig>
                                                                </misctools>
                                                            </rtePlugins>
                                                            <uiSettings jcr:primaryType="nt:unstructured">
                                                                <cui jcr:primaryType="nt:unstructured">
                                                                    <inline
                                                                        jcr:primaryType="nt:unstructured"
                                                                        toolbar="[format#bold,format#italic,links#modifylink,links#unlink,lists#unordered,lists#ordered,#justify,#lists,fullscreen#start,#modifyimage,#image,findreplace#find,findreplace#replace,spellcheck#checktext,misctools#specialchars,misctools#sourceedit,#styles,#paraformat]">
                                                                        <popovers jcr:primaryType="nt:unstructured">
                                                                            <justify
                                                                                jcr:primaryType="nt:unstructured"
                                                                                items="[justify#justifyleft,justify#justifycenter,justify#justifyright]"
                                                                                ref="justify"/>
                                                                            <lists
                                                                                jcr:primaryType="nt:unstructured"
                                                                                items="[lists#unordered,lists#ordered,lists#outdent,lists#indent]"
                                                                                ref="lists"/>
                                                                            <paraformat
                                                                                jcr:primaryType="nt:unstructured"
                                                                                items="paraformat:getFormats:paraformat-pulldown"
                                                                                ref="paraformat"/>
                                                                        </popovers>
                                                                    </inline>
                                                                </cui>
                                                            </uiSettings>
                                                        </description>
                                                        <chartType
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                            fieldLabel="Chart Type"
                                                            fieldDescription="Which renderer draws this panel"
                                                            name="chartType">
                                                            <items jcr:primaryType="nt:unstructured">
                                                                <area
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Area"
                                                                    value="area"
                                                                    selected="{Boolean}true"/>
                                                                <line
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Line"
                                                                    value="line"/>
                                                                <bar
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Bar"
                                                                    value="bar"/>
                                                                <hbar
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Horizontal Bar"
                                                                    value="hbar"/>
                                                                <stackedBar
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Stacked Bar"
                                                                    value="stacked-bar"/>
                                                                <donut
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Donut"
                                                                    value="donut"/>
                                                                <gauge
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Gauge"
                                                                    value="gauge"/>
                                                                <sparkline
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Sparkline"
                                                                    value="sparkline"/>
                                                            </items>
                                                        </chartType>
                                                        <labels
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                            fieldLabel="Labels"
                                                            fieldDescription="One label per line, or comma separated. Example: Mon, Tue, Wed"
                                                            name="labels"
                                                            rows="{Long}4"/>
                                                        <series
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                            fieldLabel="Series"
                                                            fieldDescription="One series per line, pipe delimited: Name|#colour|v1,v2,v3 - Example: Unique users|#10b981|12,18,24,19 - Both the name and the colour are optional, so |#10b981|1,2,3 and 1,2,3 also work."
                                                            name="series"
                                                            rows="{Long}5"/>
                                                        <unit
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Unit"
                                                            fieldDescription="Suffix appended to plain numbers, e.g. ms"
                                                            name="unit"/>
                                                        <valueFormat
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                            fieldLabel="Value Format"
                                                            fieldDescription="How values are formatted in labels and readouts"
                                                            name="valueFormat">
                                                            <items jcr:primaryType="nt:unstructured">
                                                                <number
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Number"
                                                                    value="number"
                                                                    selected="{Boolean}true"/>
                                                                <compact
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Compact (1.2K)"
                                                                    value="compact"/>
                                                                <bytes
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Bytes (TB / GB)"
                                                                    value="bytes"/>
                                                                <percent
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Percent"
                                                                    value="percent"/>
                                                            </items>
                                                        </valueFormat>
                                                        <decimals
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                            fieldLabel="Decimal Places"
                                                            fieldDescription="Decimal places used when formatting values"
                                                            name="decimals"
                                                            min="{Long}0"
                                                            max="{Long}6"/>
                                                        <yMax
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                            fieldLabel="Axis Maximum"
                                                            fieldDescription="Fixes the top of the value axis. Leave empty to derive it from the data. Gauges use it as 100% (default 100)."
                                                            name="yMax"/>
                                                        <total
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                            fieldLabel="Total"
                                                            fieldDescription="Stacked bar only: the capacity the segments are measured against. Defaults to the sum of the values."
                                                            name="total"/>
                                                        <totalLabel
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Total Label"
                                                            fieldDescription="Stacked bar only: caption below the bar. Defaults to a generated 'x of y' summary."
                                                            name="totalLabel"/>
                                                        <centerLabel
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Center Label"
                                                            fieldDescription="Donut and gauge only: caption under the centred value"
                                                            name="centerLabel"/>
                                                        <centerValue
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Center Value"
                                                            fieldDescription="Donut only: headline value shown in the middle of the ring, e.g. 58%"
                                                            name="centerValue"/>
                                                        <curve
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                            fieldLabel="Curve"
                                                            fieldDescription="Area and line only: how points are joined"
                                                            name="curve">
                                                            <items jcr:primaryType="nt:unstructured">
                                                                <smooth
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Smooth"
                                                                    value="smooth"
                                                                    selected="{Boolean}true"/>
                                                                <linear
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Linear"
                                                                    value="linear"/>
                                                            </items>
                                                        </curve>
                                                        <showGrid
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                            fieldDescription="Draws the horizontal grid lines behind plotted charts"
                                                            name="showGrid"
                                                            text="Show Grid Lines"
                                                            checked="{Boolean}true"
                                                            uncheckedValue="false"
                                                            value="true"/>
                                                        <showLegend
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                            fieldDescription="Adds a legend below the chart when more than one series is plotted"
                                                            name="showLegend"
                                                            text="Show Legend"
                                                            uncheckedValue="false"
                                                            value="true"/>
                                                        <showAxis
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                            fieldDescription="Draws the value and category tick labels"
                                                            name="showAxis"
                                                            text="Show Axis Labels"
                                                            checked="{Boolean}true"
                                                            uncheckedValue="false"
                                                            value="true"/>
                                                        <canvasLabel
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Chart Accessible Label"
                                                            fieldDescription="Screen reader description of the chart itself, e.g. Area chart of unique visitors per day. Falls back to the panel title."
                                                            name="canvasLabel"/>
                                                    </items>
                                                </field>
                                            </chartPanels>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </panels>
                    <appearance
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Appearance"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <style
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="Section Style"
                                                fieldDescription="Visual style of the analytics chart section"
                                                name="./style">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <none
                                                        jcr:primaryType="nt:unstructured"
                                                        text="None"
                                                        value=""
                                                        selected="{Boolean}true"/>
                                                    <withBg
                                                        jcr:primaryType="nt:unstructured"
                                                        text="With Background"
                                                        value="analytics-chart--with-bg"/>
                                                    <muted
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Muted Background"
                                                        value="analytics-chart--muted"/>
                                                </items>
                                            </style>
                                            <gridColumns
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="Grid Columns"
                                                fieldDescription="Number of panel columns on large screens"
                                                name="./columns">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <one
                                                        jcr:primaryType="nt:unstructured"
                                                        text="1 Column"
                                                        value="1"/>
                                                    <two
                                                        jcr:primaryType="nt:unstructured"
                                                        text="2 Columns"
                                                        value="2"
                                                        selected="{Boolean}true"/>
                                                    <three
                                                        jcr:primaryType="nt:unstructured"
                                                        text="3 Columns"
                                                        value="3"/>
                                                </items>
                                            </gridColumns>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </appearance>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
