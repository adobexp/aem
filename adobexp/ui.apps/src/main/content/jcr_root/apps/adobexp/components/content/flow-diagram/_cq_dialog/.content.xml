<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Flow Diagram"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        granite:class="cmp-flow-diagram__editor"
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <content
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Content"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <title
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Title"
                                                fieldDescription="Section title above the diagram"
                                                name="./title"/>
                                            <subtitle
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                fieldLabel="Subtitle"
                                                fieldDescription="Supporting text below the title"
                                                name="./subtitle"
                                                rows="{Long}3"/>
                                            <caption
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                fieldLabel="Caption"
                                                fieldDescription="Explanatory line rendered below the diagram"
                                                name="./caption"
                                                rows="{Long}3"/>
                                            <ariaLabel
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="ARIA Label"
                                                fieldDescription="Accessible name for the diagram section, announced by screen readers"
                                                name="./ariaLabel"
                                                value="Architecture flow"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </content>
                    <stages
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Stages"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <stages
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                composite="{Boolean}true"
                                                fieldLabel="Stages"
                                                fieldDescription="Pipeline stages, left to right. Connectors are drawn between consecutive stages, so the order here is the flow order.">
                                                <field
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                                    name="./stages">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <stageLabel
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Stage Label"
                                                            fieldDescription="Chip displayed above the stage (e.g. Sources)"
                                                            name="stageLabel"/>
                                                        <nodes
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                            fieldLabel="Nodes"
                                                            fieldDescription="One node per line, pipe-delimited: Icon|Title|Subtitle|Tag - for example 🌐|Websites|JavaScript SDK|Auto page views. Icon is an emoji or short glyph and may be left empty (|Websites|JS SDK); Subtitle and Tag are optional and trailing fields may be omitted. Tag renders as a small pill under the node."
                                                            name="nodes"
                                                            rows="{Long}6"/>
                                                    </items>
                                                </field>
                                            </stages>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </stages>
                    <appearance
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Appearance"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <style
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="Section Style"
                                                fieldDescription="Background treatment of the diagram section"
                                                name="./style">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <none
                                                        jcr:primaryType="nt:unstructured"
                                                        text="None"
                                                        value=""
                                                        selected="{Boolean}true"/>
                                                    <withBg
                                                        jcr:primaryType="nt:unstructured"
                                                        text="With Background"
                                                        value="flow-diagram--with-bg"/>
                                                    <muted
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Muted Background"
                                                        value="flow-diagram--muted"/>
                                                </items>
                                            </style>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </appearance>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
