<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Toggle Switch"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <!-- Tab 1: Field Configuration -->
                    <field
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Field"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <!-- Toggle Label Text -->
                                            <toggleText
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Toggle Label"
                                                fieldDescription="Text displayed next to the toggle switch"
                                                name="./toggleText"
                                                required="{Boolean}true"
                                                value="Enable option"/>
                                            <!-- Field Name (for form data) -->
                                            <fieldName
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Field Name"
                                                fieldDescription="Name attribute used when submitting form data"
                                                name="./fieldName"
                                                required="{Boolean}true"/>
                                            <!-- Default Checked -->
                                            <defaultChecked
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                fieldDescription="Toggle is checked/on by default"
                                                name="./defaultChecked"
                                                text="Checked by Default"
                                                uncheckedValue="false"
                                                value="true"/>
                                            <!-- Field Width -->
                                            <fieldWidth
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="Field Width"
                                                fieldDescription="Width of this field in the form layout"
                                                name="./fieldWidth">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <full
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Full Width"
                                                        value="full"
                                                        selected="{Boolean}true"/>
                                                    <half
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Half Width (1/2)"
                                                        value="half"/>
                                                    <third
                                                        jcr:primaryType="nt:unstructured"
                                                        text="One Third (1/3)"
                                                        value="third"/>
                                                    <twoThirds
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Two Thirds (2/3)"
                                                        value="two-thirds"/>
                                                </items>
                                            </fieldWidth>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </field>
                    
                    <!-- Tab 2: Validation -->
                    <validation
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Validation"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <!-- Required -->
                                            <required
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                fieldDescription="Toggle must be checked/enabled"
                                                name="./required"
                                                text="Required (must be enabled)"
                                                uncheckedValue="false"
                                                value="true"/>
                                            <!-- Required Message -->
                                            <requiredMessage
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Required Message"
                                                fieldDescription="Error message when required toggle is not enabled"
                                                name="./requiredMessage"
                                                value="This option must be enabled"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </validation>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
