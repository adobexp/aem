<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Metric Tiles"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        granite:class="cmp-metric-tiles__editor"
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <content
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Content"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <title
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Title"
                                                fieldDescription="Section title above the metric tiles"
                                                name="./title"/>
                                            <subtitle
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                fieldLabel="Subtitle"
                                                fieldDescription="Supporting text below the title"
                                                name="./subtitle"
                                                rows="{Long}3"/>
                                            <ariaLabel
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Accessible Label"
                                                fieldDescription="Screen-reader label for the section landmark (default: Key metrics)"
                                                name="./ariaLabel"
                                                value="Key metrics"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </content>
                    <tiles
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Tiles"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <tiles
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                composite="{Boolean}true"
                                                fieldLabel="Metric Tiles"
                                                fieldDescription="Add KPI tiles with an icon, a value and a label">
                                                <field
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                                    name="./tiles">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <icon
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Icon"
                                                            fieldDescription="Emoji or short glyph shown above the value (e.g. 📈)"
                                                            name="icon"/>
                                                        <label
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Label"
                                                            fieldDescription="Name of the metric (e.g. Monthly active users)"
                                                            name="label"/>
                                                        <value
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Value"
                                                            fieldDescription="Target number the tile counts up to. Digits with an optional decimal point and an optional leading minus sign; thousands separators are ignored. Examples: 1284, 4820000, 38.2"
                                                            name="value"/>
                                                        <prefix
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Prefix"
                                                            fieldDescription="Text rendered immediately before the number (e.g. $)"
                                                            name="prefix"/>
                                                        <suffix
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Suffix"
                                                            fieldDescription="Text rendered immediately after the number, leading space included if wanted (e.g. ' TB', '%')"
                                                            name="suffix"/>
                                                        <decimals
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                            fieldLabel="Decimal Places"
                                                            fieldDescription="Number of decimal places to display (default: 0)"
                                                            name="decimals"
                                                            min="{Long}0"
                                                            max="{Long}10"/>
                                                        <compact
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                            fieldDescription="Shorten large numbers, e.g. 4820000 renders as 4.8M"
                                                            name="compact"
                                                            text="Abbreviate Large Numbers"
                                                            uncheckedValue="false"
                                                            value="true"/>
                                                        <accentColor
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                                            fieldLabel="Accent Color"
                                                            fieldDescription="Accent colour of this tile's gradient face. Must be a CSS colour: hex (#3b82f6), rgb()/rgba()/hsl()/hsla(), or a named colour. Invalid values are ignored."
                                                            name="accentColor"
                                                            showDefaultColors="{Boolean}true"
                                                            showProperties="{Boolean}true"
                                                            showSwatches="{Boolean}true"/>
                                                        <caption
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Caption"
                                                            fieldDescription="Small supporting line below the tile face"
                                                            name="caption"/>
                                                    </items>
                                                </field>
                                            </tiles>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </tiles>
                    <appearance
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Appearance"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <style
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="Section Style"
                                                fieldDescription="Background treatment of the metric tiles section"
                                                name="./style">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <none
                                                        jcr:primaryType="nt:unstructured"
                                                        text="None"
                                                        value=""
                                                        selected="{Boolean}true"/>
                                                    <withBg
                                                        jcr:primaryType="nt:unstructured"
                                                        text="With Background"
                                                        value="metric-tiles--with-bg"/>
                                                    <muted
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Muted Background"
                                                        value="metric-tiles--muted"/>
                                                </items>
                                            </style>
                                            <columnCount
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="Grid Columns"
                                                fieldDescription="Number of tiles per row on large screens"
                                                name="./columns">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <two
                                                        jcr:primaryType="nt:unstructured"
                                                        text="2 Columns"
                                                        value="2"/>
                                                    <three
                                                        jcr:primaryType="nt:unstructured"
                                                        text="3 Columns"
                                                        value="3"/>
                                                    <four
                                                        jcr:primaryType="nt:unstructured"
                                                        text="4 Columns"
                                                        value="4"
                                                        selected="{Boolean}true"/>
                                                </items>
                                            </columnCount>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </appearance>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
