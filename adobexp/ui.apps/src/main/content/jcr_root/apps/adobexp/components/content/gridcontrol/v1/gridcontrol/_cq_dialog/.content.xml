<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Grid Control"
    sling:resourceType="cq/gui/components/authoring/dialog"
    extraClientlibs="[cq.authoring.dialog]"
    helpPath=""
    height="{Long}600"
    width="{Long}800">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <properties
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Properties"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <layoutColumns jcr:primaryType="nt:unstructured"
												sling:resourceType="granite/ui/components/coral/foundation/form/select"
												fieldLabel="Layout Columns" name="./layoutColumns" defaultValue="12">
												<items jcr:primaryType="nt:unstructured">
													<default jcr:primaryType="nt:unstructured"
														text="(Default - 100%)" value="12" />
													<c6633 jcr:primaryType="nt:unstructured"
														text="2 Columns | 66%-33%" value="8,4" />
													<c3366 jcr:primaryType="nt:unstructured"
														text="2 Columns | 33%-66%" value="4,8" />
													<c7525 jcr:primaryType="nt:unstructured"
														text="2 Columns | 75%-25%" value="9,3" />
													<c2575 jcr:primaryType="nt:unstructured"
														text="2 Columns | 25%-75%" value="3,9" />
													<c333333 jcr:primaryType="nt:unstructured"
														text="3 Columns | 33%-33%-33%" value="4,4,4" />
													<c25252525 jcr:primaryType="nt:unstructured"
														text="4 Columns | 25%-25%-25%-25%" value="3,3,3,3" />
													<c5050 jcr:primaryType="nt:unstructured"
														text="2 Columns | 50%-50%" value="6,6" />
													<c502525 jcr:primaryType="nt:unstructured"
														text="3 Columns | 50%-25%-25%" value="6,3,3" />
													<c255025 jcr:primaryType="nt:unstructured"
														text="3 Columns | 25%-50%-25%" value="3,6,3" />
													<c252550 jcr:primaryType="nt:unstructured"
														text="3 Columns | 25%-25%-50%" value="3,3,6" />
													<c206020 jcr:primaryType="nt:unstructured"
														text="3 Columns | 20%-60%-20%" value="2,8,2" />
													<c108010 jcr:primaryType="nt:unstructured"
														text="3 Columns | 10%-80%-10%" value="1,10,1" />
												</items>
											</layoutColumns>
                                            <id jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldDescription="HTML ID attribute to apply to the component."
                                                fieldLabel="ID" name="./id" />
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </properties>
                    <styleOptions
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Style Options"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <applyBackgroundColor
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                fieldDescription="When enabled, applies the theme gradient background color to the entire Grid Control component."
                                                name="./applyBackgroundColor"
                                                text="Apply Background Color to Grid Container"
                                                value="{Boolean}true"
                                                uncheckedValue="{Boolean}false"/>
                                            <columnStylesHeading
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/heading"
                                                level="5"
                                                text="Column Styles"
                                                class="coral-Heading--5"
                                                margin="{Boolean}true"/>
                                            <columnStylesDescription
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/text"
                                                text="Configure background styles for each column. Each item corresponds to a column (1st item = Column 1, 2nd item = Column 2, etc.). Extra items beyond the number of columns will be ignored."/>
                                            <columnStyles
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                composite="{Boolean}true"
                                                fieldLabel="Column Styles"
                                                fieldDescription="Add styling options for each column.">
                                                <field
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                                    name="./columnStyles">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <applyColumnBackground
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                            fieldDescription="Enable to apply background color to this column."
                                                            name="./applyColumnBackground"
                                                            text="Apply Background Color"
                                                            value="{Boolean}true"
                                                            uncheckedValue="{Boolean}false"/>
                                                        <columnBackgroundColor
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Background Color / Gradient"
                                                            fieldDescription="Enter a CSS color or gradient value. Leave empty to use the theme gradient background. Examples: #ff0000, rgba(255,0,0,0.5), linear-gradient(180deg, var(--site-body-bg) 0%, var(--main-theme-color) 50%, var(--site-body-bg) 100%);"
                                                            name="./columnBackgroundColor"
                                                            emptyText="e.g. #ff0000 or linear-gradient(...)"/>
                                                    </items>
                                                </field>
                                            </columnStyles>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </styleOptions>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
