<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Title"
    sling:resourceType="cq/gui/components/authoring/dialog"
    extraClientlibs="[adobexp.components.title.v1.editor]"
    helpPath="https://www.adobe.com/go/aem_cmp_title_v3"
    trackingFeature="core-components:title:v3">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <properties
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Properties"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <title
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldDescription="Leave empty to use the page title."
                                                fieldLabel="Title"
                                                name="./jcr:title"/>
                                            <types
                                                granite:class="core-title-sizes"
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="Type / Size"
                                                name="./type">
                                                <datasource
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="adobexp/components/content/title/v1/datasource/allowedtypes"/>
                                            </types>
                                            <defaulttypes
                                                granite:class="core-title-sizes-default"
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="Type / Size"
                                                name="./type">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <h1
                                                        jcr:primaryType="nt:unstructured"
                                                        text="H1"
                                                        value="h1"/>
                                                    <h2
                                                        jcr:primaryType="nt:unstructured"
                                                        text="H2"
                                                        value="h2"/>
                                                    <h3
                                                        jcr:primaryType="nt:unstructured"
                                                        text="H3"
                                                        value="h3"/>
                                                    <h4
                                                        jcr:primaryType="nt:unstructured"
                                                        text="H4"
                                                        value="h4"/>
                                                    <h5
                                                        jcr:primaryType="nt:unstructured"
                                                        text="H5"
                                                        value="h5"/>
                                                    <h6
                                                        jcr:primaryType="nt:unstructured"
                                                        text="H6"
                                                        value="h6"/>
                                                </items>
                                            </defaulttypes>
                                            <link
                                                granite:hide="${cqDesign.linkDisabled}"
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/include"
                                                path="/mnt/overlay/adobexp/components/commons/editor/dialog/link/v1/link/edit/link"/>
                                            <id
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldDescription="HTML ID attribute to apply to the component."
                                                fieldLabel="ID"
                                                name="./id"
												validation="html-unique-id-validator"/>
                                            <position
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="Text Alignment"
                                                fieldDescription="Choose the horizontal alignment of the title text."
                                                name="./position">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <left
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Left"
                                                        value="left"
                                                        selected="{Boolean}true"/>
                                                    <center
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Center"
                                                        value="center"/>
                                                    <right
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Right"
                                                        value="right"/>
                                                </items>
                                            </position>
                                            <mobilePosition
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="Alignment on Mobile"
                                                fieldDescription="Choose the horizontal alignment on mobile viewports."
                                                name="./mobilePosition">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <left
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Left"
                                                        value="left"
                                                        selected="{Boolean}true"/>
                                                    <center
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Center"
                                                        value="center"/>
                                                    <right
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Right"
                                                        value="right"/>
                                                </items>
                                            </mobilePosition>
                                            <marginTop
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="Margin Top"
                                                fieldDescription="Choose the top margin for the title container."
                                                name="./marginTop"
                                                emptyText="None">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <none
                                                        jcr:primaryType="nt:unstructured"
                                                        text="None"
                                                        value=""
                                                        selected="{Boolean}true"/>
                                                    <px10
                                                        jcr:primaryType="nt:unstructured"
                                                        text="10px"
                                                        value="10px"/>
                                                    <px20
                                                        jcr:primaryType="nt:unstructured"
                                                        text="20px"
                                                        value="20px"/>
                                                    <px30
                                                        jcr:primaryType="nt:unstructured"
                                                        text="30px"
                                                        value="30px"/>
                                                    <px40
                                                        jcr:primaryType="nt:unstructured"
                                                        text="40px"
                                                        value="40px"/>
                                                    <px50
                                                        jcr:primaryType="nt:unstructured"
                                                        text="50px"
                                                        value="50px"/>
                                                    <px60
                                                        jcr:primaryType="nt:unstructured"
                                                        text="60px"
                                                        value="60px"/>
                                                    <px70
                                                        jcr:primaryType="nt:unstructured"
                                                        text="70px"
                                                        value="70px"/>
                                                    <px80
                                                        jcr:primaryType="nt:unstructured"
                                                        text="80px"
                                                        value="80px"/>
                                                    <px90
                                                        jcr:primaryType="nt:unstructured"
                                                        text="90px"
                                                        value="90px"/>
                                                    <px100
                                                        jcr:primaryType="nt:unstructured"
                                                        text="100px"
                                                        value="100px"/>
                                                    <px110
                                                        jcr:primaryType="nt:unstructured"
                                                        text="110px"
                                                        value="110px"/>
                                                    <px120
                                                        jcr:primaryType="nt:unstructured"
                                                        text="120px"
                                                        value="120px"/>
                                                    <px130
                                                        jcr:primaryType="nt:unstructured"
                                                        text="130px"
                                                        value="130px"/>
                                                    <px140
                                                        jcr:primaryType="nt:unstructured"
                                                        text="140px"
                                                        value="140px"/>
                                                    <px150
                                                        jcr:primaryType="nt:unstructured"
                                                        text="150px"
                                                        value="150px"/>
                                                    <px160
                                                        jcr:primaryType="nt:unstructured"
                                                        text="160px"
                                                        value="160px"/>
                                                    <px170
                                                        jcr:primaryType="nt:unstructured"
                                                        text="170px"
                                                        value="170px"/>
                                                    <px180
                                                        jcr:primaryType="nt:unstructured"
                                                        text="180px"
                                                        value="180px"/>
                                                    <px190
                                                        jcr:primaryType="nt:unstructured"
                                                        text="190px"
                                                        value="190px"/>
                                                    <px200
                                                        jcr:primaryType="nt:unstructured"
                                                        text="200px"
                                                        value="200px"/>
                                                </items>
                                            </marginTop>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </properties>
                    <styletab
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/include"
                            path="/mnt/overlay/cq/gui/components/authoring/dialog/style/tab_edit/styletab"/>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
