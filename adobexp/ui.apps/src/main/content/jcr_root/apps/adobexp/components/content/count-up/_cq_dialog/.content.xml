<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Count Up"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        granite:class="cmp-count-up__editor"
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <!-- Tab 1: Header Content -->
                    <content
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Header Content"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <headerDescription
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/text"
                                                text="Configure the header section that appears above the counter items."/>
                                            <!-- Section Title -->
                                            <title
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Title"
                                                fieldDescription="The main headline text for the section (e.g., 'Used by Millions')"
                                                name="./title"/>
                                            <!-- Subtitle / Description -->
                                            <subtitle
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                fieldLabel="Subtitle"
                                                fieldDescription="Supporting text that appears below the title"
                                                name="./subtitle"
                                                rows="{Long}3"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </content>

                    <!-- Tab 2: Counter Items -->
                    <itemsConfig
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Counter Items"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <itemsDescription
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/text"
                                                text="Add counter items to display animated statistics. Each item will animate from the start value to the end value when it comes into view."/>
                                            <!-- Counter Items Multifield -->
                                            <counterItems
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                fieldLabel="Counter Items"
                                                fieldDescription="Add multiple counter statistics"
                                                composite="{Boolean}true">
                                                <field
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                                    name="./counterItems">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <!-- End Value -->
                                                        <endValue
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                            fieldLabel="End Value"
                                                            fieldDescription="The final number to count up to (e.g., 10 for '10M')"
                                                            name="./endValue"
                                                            min="{Double}0"
                                                            required="{Boolean}true"/>
                                                        <!-- Unit -->
                                                        <unit
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                            fieldLabel="Unit"
                                                            fieldDescription="Suffix to append to the number"
                                                            name="./unit">
                                                            <items jcr:primaryType="nt:unstructured">
                                                                <none
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="None"
                                                                    value=""
                                                                    selected="{Boolean}true"/>
                                                                <million
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Million (M)"
                                                                    value="M"/>
                                                                <thousand
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Thousand (K)"
                                                                    value="K"/>
                                                                <billion
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Billion (B)"
                                                                    value="B"/>
                                                                <percent
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Percent (%)"
                                                                    value="%"/>
                                                                <plus
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Plus (+)"
                                                                    value="+"/>
                                                            </items>
                                                        </unit>
                                                        <!-- Custom Unit -->
                                                        <customUnit
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Custom Unit"
                                                            fieldDescription="Enter custom unit if not in the dropdown (overrides Unit selection)"
                                                            name="./customUnit"/>
                                                        <!-- Label -->
                                                        <label
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Label"
                                                            fieldDescription="Description text below the number (e.g., 'Total Downloads')"
                                                            name="./label"
                                                            required="{Boolean}true"/>
                                                        <!-- Start Value -->
                                                        <startValue
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                            fieldLabel="Start Value"
                                                            fieldDescription="The initial number to start counting from (default: 0)"
                                                            name="./startValue"
                                                            value="{Double}0"/>
                                                        <!-- Decimals -->
                                                        <decimals
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                            fieldLabel="Decimal Places"
                                                            fieldDescription="Number of decimal places to display (default: 0)"
                                                            name="./decimals"
                                                            min="{Double}0"
                                                            max="{Double}4"
                                                            value="{Double}0"/>
                                                    </items>
                                                </field>
                                            </counterItems>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </itemsConfig>

                    <!-- Tab 3: Animation Settings -->
                    <animationConfig
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Animation"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <animationDescription
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/text"
                                                text="Configure the count-up animation settings. These settings apply to all counter items."/>
                                            <!-- Animation Duration -->
                                            <duration
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                fieldLabel="Animation Duration (ms)"
                                                fieldDescription="Duration of the count-up animation in milliseconds (default: 2000)"
                                                name="./duration"
                                                min="{Double}500"
                                                max="{Double}10000"
                                                step="{Double}100"
                                                value="{Double}2000"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </animationConfig>

                    <!-- Tab 4: Style Options -->
                    <styleOptions
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Style Options"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <styleDescription
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/text"
                                                text="Configure the visual appearance of the component. Theme (dark/light) is controlled at the page template level."/>
                                            <!-- With Background Checkbox -->
                                            <withBackground
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                fieldDescription="Apply a background color to the section"
                                                name="./withBackground"
                                                text="Apply Background Color"
                                                checked="{Boolean}true"
                                                uncheckedValue="false"
                                                value="true"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </styleOptions>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
