<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Code Snippet"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        granite:class="cmp-code-snippet__editor"
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <content
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Content"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <title
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Title"
                                                fieldDescription="Section title above the code viewer"
                                                name="./title"/>
                                            <subtitle
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                fieldLabel="Subtitle"
                                                fieldDescription="Supporting text below the title"
                                                name="./subtitle"
                                                rows="{Long}3"/>
                                            <ariaLabel
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Accessible Label"
                                                fieldDescription="Screen-reader label for the section (default: Code samples)"
                                                name="./ariaLabel"
                                                value="Code samples"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </content>
                    <snippets
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Snippets"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <items
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                composite="{Boolean}true"
                                                fieldLabel="Snippets"
                                                fieldDescription="Each snippet becomes one tab. The first snippet is shown by default.">
                                                <field
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                                    name="./snippets">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <tabLabel
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Tab Label"
                                                            fieldDescription="Short label shown on the tab (e.g. Website (JS))"
                                                            name="tabLabel"/>
                                                        <language
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                            fieldLabel="Language"
                                                            fieldDescription="Drives the syntax highlighting of this snippet"
                                                            name="language">
                                                            <items jcr:primaryType="nt:unstructured">
                                                                <javascript
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="JavaScript"
                                                                    value="javascript"
                                                                    selected="{Boolean}true"/>
                                                                <json
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="JSON"
                                                                    value="json"/>
                                                                <bash
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Bash / shell"
                                                                    value="bash"/>
                                                                <sql
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="SQL"
                                                                    value="sql"/>
                                                                <xml
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="XML / HTML"
                                                                    value="xml"/>
                                                                <java
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Java"
                                                                    value="java"/>
                                                                <text
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Plain text"
                                                                    value="text"/>
                                                            </items>
                                                        </language>
                                                        <filename
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Filename"
                                                            fieldDescription="Optional caption shown in the tab bar for this snippet (e.g. infralytiqs-bootstrap.js)"
                                                            name="filename"/>
                                                        <code
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                            fieldLabel="Code"
                                                            fieldDescription="Paste the source exactly as it should render. Indentation and line breaks are preserved, and the markup is escaped for you - type &lt;script&gt; rather than an entity. Avoid leading or trailing blank lines so the line numbers line up."
                                                            name="code"
                                                            rows="{Long}18"/>
                                                    </items>
                                                </field>
                                            </items>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </snippets>
                    <appearance
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Appearance"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <style
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="Section Style"
                                                fieldDescription="Background treatment of the section"
                                                name="./style">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <none
                                                        jcr:primaryType="nt:unstructured"
                                                        text="None"
                                                        value=""
                                                        selected="{Boolean}true"/>
                                                    <withBg
                                                        jcr:primaryType="nt:unstructured"
                                                        text="With Background"
                                                        value="code-snippet--with-bg"/>
                                                    <muted
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Muted Background"
                                                        value="code-snippet--muted"/>
                                                </items>
                                            </style>
                                            <showLineNumbers
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                fieldDescription="Show a line-number gutter to the left of every snippet"
                                                name="./showLineNumbers"
                                                text="Show Line Numbers"
                                                checked="{Boolean}true"
                                                uncheckedValue="false"
                                                value="true"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </appearance>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
