<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Subscription Plans"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        granite:class="cmp-subscription-plans__editor"
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <!-- Tab 1: Plan 1 -->
                    <plan1
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Plan 1"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <plan1Name
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Plan Name"
                                                name="./plan1Name"/>
                                            <plan1MonthlyPrice
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Monthly Price"
                                                name="./plan1MonthlyPrice"/>
                                            <plan1YearlyOriginalPrice
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Yearly Original Price"
                                                name="./plan1YearlyOriginalPrice"/>
                                            <plan1YearlyPrice
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Yearly Price"
                                                name="./plan1YearlyPrice"/>
                                            <plan1DiscountUntil
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
                                                fieldLabel="Discount Until"
                                                fieldDescription="Format: YYYY-MM-DD"
                                                name="./plan1DiscountUntil"
                                                displayedFormat="YYYY-MM-DD"
                                                valueFormat="YYYY-MM-DD"/>
                                            <plan1CtaText
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="CTA Text"
                                                name="./plan1CtaText"/>
                                            <plan1CtaLink
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                fieldLabel="CTA Link"
                                                name="./plan1CtaLink"
                                                rootPath="/content"/>
                                            <plan1CtaNewTab
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                text="Open CTA in new tab"
                                                name="./plan1CtaNewTab"
                                                checked="{Boolean}false"
                                                uncheckedValue="false"
                                                value="true"/>
                                            <plan1TopChoice
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                text="Show Top Choice badge"
                                                name="./plan1TopChoice"
                                                checked="{Boolean}false"
                                                uncheckedValue="false"
                                                value="true"/>
                                            <plan1SpecialOffer
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                text="Show Special Offer badge"
                                                name="./plan1SpecialOffer"
                                                checked="{Boolean}false"
                                                uncheckedValue="false"
                                                value="true"/>
                                            <plan1CreditsValue
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Credits Value"
                                                name="./plan1CreditsValue"/>
                                            <plan1CreditsUnit
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Credits Unit"
                                                name="./plan1CreditsUnit"/>
                                            <plan1CreditsLabel
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Credits Label"
                                                name="./plan1CreditsLabel"/>
                                            <plan1Features
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                fieldLabel="Plan Features"
                                                composite="{Boolean}true">
                                                <field
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                                    name="./plan1Features">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <feature
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Feature Title"
                                                            name="feature"/>
                                                    </items>
                                                </field>
                                            </plan1Features>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </plan1>

                    <!-- Tab 2: Plan 2 -->
