                                                name="./plan2MonthlyPrice"/>
                                            <plan2YearlyOriginalPrice
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Yearly Original Price"
                                                name="./plan2YearlyOriginalPrice"/>
                                            <plan2YearlyPrice
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Yearly Price"
                                                name="./plan2YearlyPrice"/>
                                            <plan2DiscountUntil
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
                                                fieldLabel="Discount Until"
                                                fieldDescription="Format: YYYY-MM-DD"
                                                name="./plan2DiscountUntil"
                                                displayedFormat="YYYY-MM-DD"
                                                valueFormat="YYYY-MM-DD"/>
                                            <plan2CtaText
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="CTA Text"
