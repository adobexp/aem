                    <!-- Tab 5: Common Settings -->
                    <common
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Common Settings"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <title
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Component Title"
                                                name="./title"
                                                value="Pick your plan"/>
                                            <description
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                fieldLabel="Component Description"
                                                name="./description"
                                                rows="{Long}3"/>
                                            <defaultBilling
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="Default Billing"
                                                name="./defaultBilling">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <monthly
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Monthly"
                                                        value="monthly"/>
                                                    <yearly
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Yearly"
                                                        value="yearly"
                                                        selected="{Boolean}true"/>
                                                </items>
                                            </defaultBilling>
                                            <yearlyDiscountText
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Yearly Discount Text"
                                                name="./yearlyDiscountText"
                                                value="SAVE 33%"/>
                                            <currencySymbol
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Currency Symbol"
                                                name="./currencySymbol"
                                                value="$"/>
                                            <monthlyBillingNote
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Monthly Billing Note"
                                                name="./monthlyBillingNote"
                                                value="Billed monthly"/>
                                            <yearlyBillingNote
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Yearly Billing Note"
                                                name="./yearlyBillingNote"
                                                value="Billed yearly"/>
                                            <withBackground
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                text="Apply Background Color"
                                                name="./withBackground"
                                                checked="{Boolean}true"
                                                uncheckedValue="false"
                                                value="true"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </common>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
