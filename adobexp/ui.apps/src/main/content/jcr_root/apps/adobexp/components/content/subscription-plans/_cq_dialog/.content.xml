                                                fieldLabel="CTA Link"
                                                name="./plan2CtaLink"
                                                rootPath="/content"/>
                                            <plan2CtaNewTab
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                text="Open CTA in new tab"
                                                name="./plan2CtaNewTab"
                                                checked="{Boolean}false"
                                                uncheckedValue="false"
                                                value="true"/>
                                            <plan2TopChoice
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                text="Show Top Choice badge"
                                                name="./plan2TopChoice"
                                                checked="{Boolean}false"
                                                uncheckedValue="false"
                                                value="true"/>
                                            <plan2SpecialOffer
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                text="Show Special Offer badge"
                                                name="./plan2SpecialOffer"
                                                checked="{Boolean}false"
                                                uncheckedValue="false"
                                                value="true"/>
                                            <plan2CreditsValue
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Credits Value"
                                                name="./plan2CreditsValue"/>
                                            <plan2CreditsUnit
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Credits Unit"
                                                name="./plan2CreditsUnit"/>
                                            <plan2CreditsLabel
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Credits Label"
                                                name="./plan2CreditsLabel"/>
                                            <plan2Features
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                fieldLabel="Plan Features"
                                                composite="{Boolean}true">
                                                <field
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                                    name="./plan2Features">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <feature
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Feature Title"
                                                            name="feature"/>
                                                    </items>
                                                </field>
                                            </plan2Features>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </plan2>

                    <!-- Tab 3: Plan 3 -->
                    <plan3
