<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="FAQ"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        granite:class="cmp-faq__editor"
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <!-- Tab 1: Content Configuration -->
                    <content
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Content"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <!-- Section Title Text Field -->
                                            <faqTitle
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Section Title"
                                                fieldDescription="Enter the FAQ section title (e.g., 'Frequently Asked Questions')"
                                                name="./faqTitle"/>
                                            
                                            <!-- FAQ Items Multifield -->
                                            <faqItemsContainer
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/foundation/container">
                                                <layout
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/foundation/layouts/container"/>
                                                <items jcr:primaryType="nt:unstructured">
                                                    <faqItems
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                        composite="{Boolean}true"
                                                        fieldLabel="FAQ Items"
                                                        fieldDescription="Add FAQ items with question and answer">
                                                        <field
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/container"
                                                            name="./faqItems">
                                                            <items jcr:primaryType="nt:unstructured">
                                                                <!-- Collapsible wrapper for FAQ items -->
                                                                <wrapper
                                                                    jcr:primaryType="nt:unstructured"
                                                                    jcr:title="FAQ Item"
                                                                    sling:resourceType="granite/ui/components/foundation/container">
                                                                    <layout
                                                                        jcr:primaryType="nt:unstructured"
                                                                        sling:resourceType="granite/ui/components/foundation/layouts/collapsible"/>
                                                                    <items jcr:primaryType="nt:unstructured">
                                                                        <!-- Question Text Field -->
                                                                        <faqQuestion
                                                                            jcr:primaryType="nt:unstructured"
                                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                            fieldLabel="Question"
                                                                            fieldDescription="Enter the FAQ question"
                                                                            name="faqQuestion"
                                                                            required="{Boolean}true"/>
                                                                        <!-- Answer Rich Text Editor -->
                                                                        <faqAnswer
                                                                            jcr:primaryType="nt:unstructured"
                                                                            sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                                                                            fieldLabel="Answer"
                                                                            fieldDescription="Enter the FAQ answer (supports rich text formatting)"
                                                                            name="faqAnswer"
                                                                            useFixedInlineToolbar="{Boolean}true">
                                                                            <rtePlugins jcr:primaryType="nt:unstructured">
                                                                                <format
                                                                                    jcr:primaryType="nt:unstructured"
                                                                                    features="*"/>
                                                                                <justify
                                                                                    jcr:primaryType="nt:unstructured"
                                                                                    features="*"/>
                                                                                <links
                                                                                    jcr:primaryType="nt:unstructured"
                                                                                    features="*"/>
                                                                                <lists
                                                                                    jcr:primaryType="nt:unstructured"
                                                                                    features="*"/>
                                                                                <paraformat
                                                                                    jcr:primaryType="nt:unstructured"
                                                                                    features="*">
                                                                                    <formats jcr:primaryType="nt:unstructured">
                                                                                        <p
                                                                                            jcr:primaryType="nt:unstructured"
                                                                                            description="Paragraph"
                                                                                            tag="p"/>
                                                                                        <h4
                                                                                            jcr:primaryType="nt:unstructured"
                                                                                            description="Heading 4"
                                                                                            tag="h4"/>
                                                                                        <h5
                                                                                            jcr:primaryType="nt:unstructured"
                                                                                            description="Heading 5"
                                                                                            tag="h5"/>
                                                                                        <h6
                                                                                            jcr:primaryType="nt:unstructured"
                                                                                            description="Heading 6"
                                                                                            tag="h6"/>
                                                                                        <blockquote
                                                                                            jcr:primaryType="nt:unstructured"
                                                                                            description="Quote"
                                                                                            tag="blockquote"/>
                                                                                        <pre
                                                                                            jcr:primaryType="nt:unstructured"
                                                                                            description="Preformatted"
                                                                                            tag="pre"/>
                                                                                    </formats>
                                                                                </paraformat>
                                                                                <subsuperscript
                                                                                    jcr:primaryType="nt:unstructured"
                                                                                    features="*"/>
                                                                                <misctools
                                                                                    jcr:primaryType="nt:unstructured"
                                                                                    features="*"/>
                                                                                <sourceedit
                                                                                    jcr:primaryType="nt:unstructured"
                                                                                    features="*"/>
                                                                                <undo
                                                                                    jcr:primaryType="nt:unstructured"
                                                                                    features="*"/>
                                                                            </rtePlugins>
                                                                            <uiSettings jcr:primaryType="nt:unstructured">
                                                                                <cui jcr:primaryType="nt:unstructured">
                                                                                    <inline
                                                                                        jcr:primaryType="nt:unstructured"
                                                                                        toolbar="[format#bold,format#italic,format#underline,#justify,links#modifylink,links#unlink,lists#unordered,lists#ordered,lists#indent,lists#outdent,subsuperscript#subscript,subsuperscript#superscript,misctools#specialchars,sourceedit#sourceedit,undo#undo,undo#redo]"/>
                                                                                    <dialogFullScreen
                                                                                        jcr:primaryType="nt:unstructured"
                                                                                        toolbar="[format#bold,format#italic,format#underline,justify#justifyleft,justify#justifycenter,justify#justifyright,links#modifylink,links#unlink,lists#unordered,lists#ordered,lists#indent,lists#outdent,paraformat#paraformat,subsuperscript#subscript,subsuperscript#superscript,misctools#specialchars,sourceedit#sourceedit,undo#undo,undo#redo]">
                                                                                        <popovers jcr:primaryType="nt:unstructured">
                                                                                            <paraformat
                                                                                                jcr:primaryType="nt:unstructured"
                                                                                                items="[paraformat#paraformat]"
                                                                                                ref="paraformat"/>
                                                                                        </popovers>
                                                                                    </dialogFullScreen>
                                                                                </cui>
                                                                            </uiSettings>
                                                                        </faqAnswer>
                                                                        <!-- Expanded by Default Checkbox -->
                                                                        <faqExpanded
                                                                            jcr:primaryType="nt:unstructured"
                                                                            sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                                            fieldDescription="Expand this item by default when the page loads"
                                                                            name="faqExpanded"
                                                                            text="Expanded by Default"
                                                                            uncheckedValue="false"
                                                                            value="true"/>
                                                                    </items>
                                                                </wrapper>
                                                            </items>
                                                        </field>
                                                    </faqItems>
                                                </items>
                                            </faqItemsContainer>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </content>
                    
                    <!-- Tab 2: Style Options -->
                    <styleOptions
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Style Options"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <!-- With Background Checkbox -->
                                            <withBackground
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                fieldDescription="Apply a background color to the FAQ section"
                                                name="./withBackground"
                                                text="Apply Background Color"
                                                checked="{Boolean}true"
                                                uncheckedValue="false"
                                                value="true"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </styleOptions>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
