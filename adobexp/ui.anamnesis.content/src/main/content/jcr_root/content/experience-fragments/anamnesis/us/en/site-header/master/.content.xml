<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        jcr:primaryType="cq:PageContent"
        jcr:title="Site Header"
        cq:template="/conf/adobexp/settings/wcm/templates/xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        cq:tags="[experience-fragments:variation/web]"
        sling:resourceType="adobexp/components/global/pages/xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="adobexp/components/container"
            layout="responsiveGrid">
            <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="adobexp/components/global/header"
                defaultTheme="dark"
                logoDarkImage="/content/dam/anamnesis/logos/logo-dark.svg"
                logoDarkAlt="Anamnesis Cloud"
                logoLightImage="/content/dam/anamnesis/logos/logo-light.svg"
                logoLightAlt="Anamnesis Cloud"
                logoLink="/content/anamnesis/us/en">
                <menuItems jcr:primaryType="nt:unstructured">
                    <item0
                        jcr:primaryType="nt:unstructured"
                        menuItemType="leaf"
                        menuTitle="Home"
                        menuLink="/content/anamnesis/us/en"/>
                    <item1
                        jcr:primaryType="nt:unstructured"
                        menuItemType="leaf"
                        menuTitle="About Us"
                        menuLink="/content/anamnesis/us/en/about"/>
                    <item2
                        jcr:primaryType="nt:unstructured"
                        menuItemType="leaf"
                        menuTitle="Features"
                        menuLink="/content/anamnesis/us/en/features"/>
                    <item3
                        jcr:primaryType="nt:unstructured"
                        menuItemType="leaf"
                        menuTitle="Install"
                        menuLink="/content/anamnesis/us/en/install"/>
                    <item4
                        jcr:primaryType="nt:unstructured"
                        menuItemType="leaf"
                        menuTitle="Learn"
                        menuLink="/content/anamnesis/us/en/learn"/>
                    <item5
                        jcr:primaryType="nt:unstructured"
                        menuItemType="leaf"
                        menuTitle="Contact Us"
                        menuLink="/content/anamnesis/us/en/contact"/>
                </menuItems>
            </header>
        </root>
    </jcr:content>
</jcr:root>
