<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        jcr:primaryType="cq:PageContent"
        jcr:title="Site Footer"
        cq:template="/conf/adobexp/settings/wcm/templates/xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        cq:tags="[experience-fragments:variation/web]"
        sling:resourceType="adobexp/components/global/pages/xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="adobexp/components/container"
            layout="responsiveGrid">
            <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="adobexp/components/global/footer"
                footerHeading="Anamnesis Cloud"
                footerLead="Interactive knowledge graphs for AI-assisted coding."
                mainMenuTitle="Navigation"
                usefulMenuTitle="Links"
                copyrightText="© 2026 SharadTech. Anamnesis Cloud. MIT License.">
                <mainMenuItems jcr:primaryType="nt:unstructured">
                    <item0
                        jcr:primaryType="nt:unstructured"
                        menuItemTitle="About Us"
                        menuItemLink="/content/anamnesis/us/en/about"
                        menuItemExternal="false"/>
                    <item1
                        jcr:primaryType="nt:unstructured"
                        menuItemTitle="Features"
                        menuItemLink="/content/anamnesis/us/en/features"
                        menuItemExternal="false"/>
                    <item2
                        jcr:primaryType="nt:unstructured"
                        menuItemTitle="Install"
                        menuItemLink="/content/anamnesis/us/en/install"
                        menuItemExternal="false"/>
                    <item3
                        jcr:primaryType="nt:unstructured"
                        menuItemTitle="Learn"
                        menuItemLink="/content/anamnesis/us/en/learn"
                        menuItemExternal="false"/>
                    <item4
                        jcr:primaryType="nt:unstructured"
                        menuItemTitle="Contact Us"
                        menuItemLink="/content/anamnesis/us/en/contact"
                        menuItemExternal="false"/>
                </mainMenuItems>
                <usefulMenuItems jcr:primaryType="nt:unstructured">
                    <item0
                        jcr:primaryType="nt:unstructured"
                        usefulItemTitle="Anamnesis Cloud"
                        usefulItemLink="https://www.anamnesis.cloud"
                        usefulItemExternal="true"/>
                    <item1
                        jcr:primaryType="nt:unstructured"
                        usefulItemTitle="GitHub"
                        usefulItemLink="https://github.com/sharadtech/st-anamnesis-vscode-extension"
                        usefulItemExternal="true"/>
                </usefulMenuItems>
            </footer>
        </root>
    </jcr:content>
</jcr:root>
