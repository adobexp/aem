<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        jcr:primaryType="cq:PageContent"
        jcr:title="Learn"
        jcr:description="Learn how Anamnesis Cloud works - quick start guide, extractor reference, MCP tools, and use cases."
        cq:template="/conf/adobexp/settings/wcm/templates/anamnesis-content-page"
        cq:conf="/conf/adobexp"
        sling:resourceType="adobexp/components/structure/page"
        cq:designPath="/apps/settings/wcm/designs/adobexp">
        <main-content
            jcr:primaryType="nt:unstructured"
            sling:resourceType="adobexp/components/container"
            layout="responsiveGrid">
            <pageheader
                jcr:primaryType="nt:unstructured"
                sling:resourceType="adobexp/components/content/page-header"
                title="Learn"
                subtitle="Guides, references, and use cases for getting the most from Anamnesis."/>
            <prose
                jcr:primaryType="nt:unstructured"
                sling:resourceType="adobexp/components/content/prose">
                <blocks jcr:primaryType="nt:unstructured">
                    <item0
                        jcr:primaryType="nt:unstructured"
                        content="&lt;h2&gt;How It Works&lt;/h2&gt;&lt;p&gt;Anamnesis scans your workspace folder using language-specific extractors powered by tree-sitter and custom parsers. Each extractor produces nodes (files, classes, functions, config blocks) and edges (&lt;code&gt;contains&lt;/code&gt;, &lt;code&gt;imports&lt;/code&gt;, &lt;code&gt;calls&lt;/code&gt;).&lt;/p&gt;&lt;p&gt;The unified graph is uploaded to Anamnesis Cloud and can be queried from the VS Code extension or via MCP tools when AI integration is enabled.&lt;/p&gt;"/>
                    <item1
                        jcr:primaryType="nt:unstructured"
                        content="&lt;h2&gt;Quick Start Workflow&lt;/h2&gt;&lt;ol&gt;&lt;li&gt;Install the extension and configure credentials.&lt;/li&gt;&lt;li&gt;Right-click a folder - &lt;strong&gt;Create Knowledge Graph&lt;/strong&gt;.&lt;/li&gt;&lt;li&gt;Browse the project in the &lt;strong&gt;Projects&lt;/strong&gt; tree.&lt;/li&gt;&lt;li&gt;Switch between Table and Graph views.&lt;/li&gt;&lt;li&gt;Click nodes to jump to source code.&lt;/li&gt;&lt;li&gt;Enable AI Tools for MCP-powered agent queries.&lt;/li&gt;&lt;/ol&gt;"/>
                </blocks>
            </prose>
            <datatable
                jcr:primaryType="nt:unstructured"
                sling:resourceType="adobexp/components/content/data-table"
                title="Extractor Reference"
                subtitle="Extractors run automatically when you create a knowledge graph."
                withBackground="true">
                <headers jcr:primaryType="nt:unstructured">
                    <item0
                        jcr:primaryType="nt:unstructured"
                        headerText="Technology"/>
                    <item1
                        jcr:primaryType="nt:unstructured"
                        headerText="File Patterns"/>
                    <item2
                        jcr:primaryType="nt:unstructured"
                        headerText="Graph Entities"/>
                </headers>
                <rows jcr:primaryType="nt:unstructured">
                    <item0
                        jcr:primaryType="nt:unstructured"
                        cells="&lt;strong&gt;TypeScript / JavaScript&lt;/strong&gt; | &lt;code&gt;.ts, .tsx, .js, .jsx, .mjs, .cjs&lt;/code&gt; | classes, interfaces, functions, methods, imports, calls"/>
                    <item1
                        jcr:primaryType="nt:unstructured"
                        cells="&lt;strong&gt;Java&lt;/strong&gt; | &lt;code&gt;.java&lt;/code&gt; | classes, interfaces, methods, imports, invocations"/>
                    <item2
                        jcr:primaryType="nt:unstructured"
                        cells="&lt;strong&gt;Maven&lt;/strong&gt; | &lt;code&gt;pom.xml, *.pom&lt;/code&gt; | projects, modules, dependencies, plugins, properties, profiles"/>
                    <item3
                        jcr:primaryType="nt:unstructured"
                        cells="&lt;strong&gt;HTL / Sightly (AEM)&lt;/strong&gt; | &lt;code&gt;.html with data-sly-*&lt;/code&gt; | components, Sling Models, includes, templates"/>
                    <item4
                        jcr:primaryType="nt:unstructured"
                        cells="&lt;strong&gt;AEM Content XML&lt;/strong&gt; | &lt;code&gt;.content.xml&lt;/code&gt; | components, dialogs, tabs, fields, clientlibs"/>
                    <item5
                        jcr:primaryType="nt:unstructured"
                        cells="&lt;strong&gt;Apache Web Server&lt;/strong&gt; | &lt;code&gt;.conf, .any&lt;/code&gt; | vhosts, domains, SSL, proxies, backends"/>
                    <item6
                        jcr:primaryType="nt:unstructured"
                        cells="&lt;strong&gt;NGINX Server&lt;/strong&gt; | &lt;code&gt;.conf, .upstream.conf&lt;/code&gt; | server blocks, upstreams, backends, locations"/>
                    <item7
                        jcr:primaryType="nt:unstructured"
                        cells="&lt;strong&gt;Markdown Architecture&lt;/strong&gt; | &lt;code&gt;.md&lt;/code&gt; | projects, modules, API routes, Mermaid flows"/>
                    <item8
                        jcr:primaryType="nt:unstructured"
                        cells="&lt;strong&gt;Bash&lt;/strong&gt; | &lt;code&gt;.sh, .bash&lt;/code&gt; | functions, commands, env vars, deploy targets"/>
                    <item9
                        jcr:primaryType="nt:unstructured"
                        cells="&lt;strong&gt;Jenkins Pipeline&lt;/strong&gt; | &lt;code&gt;Jenkinsfile, *.jenkinsfile&lt;/code&gt; | pipelines, stages, steps, environment"/>
                </rows>
            </datatable>
            <cards_mcp
                jcr:primaryType="nt:unstructured"
                sling:resourceType="adobexp/components/content/cards"
                title="MCP Tools Reference"
                subtitle="When AI Tools are enabled, agents can call these MCP tools against your knowledge graphs."
                gridVariant="3"
                variant="with-bg"
                withBackground="true">
                <cardItems jcr:primaryType="nt:unstructured">
                    <item0
                        jcr:primaryType="nt:unstructured"
                        itemTitle="&lt;code class=&quot;cards__item-code&quot;&gt;list_projects&lt;/code&gt;"
                        description="&lt;p&gt;List all knowledge-graph projects with node/edge counts&lt;/p&gt;"/>
                    <item1
                        jcr:primaryType="nt:unstructured"
                        itemTitle="&lt;code class=&quot;cards__item-code&quot;&gt;graph_stats&lt;/code&gt;"
                        description="&lt;p&gt;Overview of a project graph: nodes, edges, communities&lt;/p&gt;"/>
                    <item2
                        jcr:primaryType="nt:unstructured"
                        itemTitle="&lt;code class=&quot;cards__item-code&quot;&gt;search_symbols&lt;/code&gt;"
                        description="&lt;p&gt;Find nodes by name, id, or source file&lt;/p&gt;"/>
                    <item3
                        jcr:primaryType="nt:unstructured"
                        itemTitle="&lt;code class=&quot;cards__item-code&quot;&gt;get_node&lt;/code&gt;"
                        description="&lt;p&gt;Get a symbol with its callers, callees, and imports&lt;/p&gt;"/>
                    <item4
                        jcr:primaryType="nt:unstructured"
                        itemTitle="&lt;code class=&quot;cards__item-code&quot;&gt;get_neighbors&lt;/code&gt;"
                        description="&lt;p&gt;Direct neighbors of a symbol (in, out, or both)&lt;/p&gt;"/>
                    <item5
                        jcr:primaryType="nt:unstructured"
                        itemTitle="&lt;code class=&quot;cards__item-code&quot;&gt;shortest_path&lt;/code&gt;"
                        description="&lt;p&gt;Dependency path between two symbols&lt;/p&gt;"/>
                    <item6
                        jcr:primaryType="nt:unstructured"
                        itemTitle="&lt;code class=&quot;cards__item-code&quot;&gt;impact_of_change&lt;/code&gt;"
                        description="&lt;p&gt;Everything that depends on a symbol (blast radius)&lt;/p&gt;"/>
                    <item7
                        jcr:primaryType="nt:unstructured"
                        itemTitle="&lt;code class=&quot;cards__item-code&quot;&gt;god_nodes&lt;/code&gt;"
                        description="&lt;p&gt;Most connected nodes - architectural hubs&lt;/p&gt;"/>
                    <item8
                        jcr:primaryType="nt:unstructured"
                        itemTitle="&lt;code class=&quot;cards__item-code&quot;&gt;query_graph&lt;/code&gt;"
                        description="&lt;p&gt;Keyword-driven scoped subgraph for any question&lt;/p&gt;"/>
                </cardItems>
            </cards_mcp>
            <cards_usecases
                jcr:primaryType="nt:unstructured"
                sling:resourceType="adobexp/components/content/cards"
                title="Use Cases"
                subtitle=""
                gridVariant="2"
                variant="muted"
                withBackground="false">
                <cardItems jcr:primaryType="nt:unstructured">
                    <item0
                        jcr:primaryType="nt:unstructured"
                        itemTitle="Architecture Exploration"
                        description="&lt;p&gt;Use &lt;code&gt;query_graph&lt;/code&gt; to ask &quot;where is authentication handled?&quot; and get a scoped subgraph instead of grepping hundreds of files.&lt;/p&gt;"/>
                    <item1
                        jcr:primaryType="nt:unstructured"
                        itemTitle="Dependency Analysis"
                        description="&lt;p&gt;Trace &lt;code&gt;shortest_path&lt;/code&gt; between two symbols to understand how modules, classes, or config blocks connect.&lt;/p&gt;"/>
                    <item2
                        jcr:primaryType="nt:unstructured"
                        itemTitle="Impact Assessment"
                        description="&lt;p&gt;Run &lt;code&gt;impact_of_change&lt;/code&gt; before editing a function to see everything that depends on it - callers, imports, and downstream effects.&lt;/p&gt;"/>
                    <item3
                        jcr:primaryType="nt:unstructured"
                        itemTitle="Architectural Hotspots"
                        description="&lt;p&gt;Use &lt;code&gt;god_nodes&lt;/code&gt; to find the most connected nodes - hubs that affect many parts of the system and deserve careful review.&lt;/p&gt;"/>
                </cardItems>
            </cards_usecases>
        </main-content>
    </jcr:content>
</jcr:root>
