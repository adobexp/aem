<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.adobexp</groupId>
        <artifactId>adobexp-aem-quickstart-parent</artifactId>
        <version>2.0.8-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>adobexp-aem-quickstart.ui.anamnesis.content</artifactId>
    <packaging>content-package</packaging>
    <name>AdobeXP - AEM Quickstart UI Anamnesis content</name>
    <description>Anamnesis website content package (pages, experience fragments, DAM) for AdobeXP - AEM Quickstart</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.jackrabbit</groupId>
                <artifactId>filevault-package-maven-plugin</artifactId>
                <configuration>
                    <properties>
                        <cloudManagerTarget>none</cloudManagerTarget>
                    </properties>
                    <group>com.adobexp</group>
                    <name>adobexp-aem-quickstart.ui.anamnesis.content</name>
                    <packageType>content</packageType>
                    <accessControlHandling>ignore</accessControlHandling>
                    <validatorsSettings>
                        <jackrabbit-filter>
                            <options>
                                <validRoots>/conf,/content,/content/experience-fragments,/content/dam</validRoots>
                            </options>
                        </jackrabbit-filter>
                        <jackrabbit-accesscontrol>
                            <isDisabled>true</isDisabled>
                        </jackrabbit-accesscontrol>
                    </validatorsSettings>
                    <dependencies>
                        <dependency>
                            <groupId>com.adobexp</groupId>
                            <artifactId>adobexp-aem-quickstart.ui.apps</artifactId>
                            <version>${project.version}</version>
                        </dependency>
                    </dependencies>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.day.jcr.vault</groupId>
                <artifactId>content-package-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <verbose>true</verbose>
                    <failOnError>true</failOnError>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.adobexp</groupId>
            <artifactId>adobexp-aem-quickstart.core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.adobexp</groupId>
            <artifactId>adobexp-aem-quickstart.ui.apps</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.adobe.aem</groupId>
            <artifactId>uber-jar</artifactId>
        </dependency>
    </dependencies>
</project>
