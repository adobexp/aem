<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.adobexp</groupId>
        <artifactId>adobexp-aem-quickstart-parent</artifactId>
        <version>2.0.9</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>adobexp-aem-quickstart.all</artifactId>
    <packaging>content-package</packaging>
    <name>AdobeXP - AEM Quickstart All</name>
    <description>All content package for AdobeXP - AEM Quickstart</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.jackrabbit</groupId>
                <artifactId>filevault-package-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <group>com.adobexp</group>
                    <packageType>container</packageType>
                    <!-- skip sub package validation for now as some vendor packages like CIF apps will not pass -->
                    <skipSubPackageValidation>true</skipSubPackageValidation>
                    <embeddeds>
                        <embedded>
                            <groupId>com.adobexp</groupId>
                            <artifactId>adobexp-aem-quickstart.ui.apps</artifactId>
                            <type>zip</type>
                            <target>/apps/adobexp-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.adobexp</groupId>
                            <artifactId>adobexp-aem-quickstart.core</artifactId>
                            <target>/apps/adobexp-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.adobexp</groupId>
                            <artifactId>adobexp-aem-quickstart.ui.content</artifactId>
                            <type>zip</type>
                            <target>/apps/adobexp-packages/content/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.adobexp</groupId>
                            <artifactId>adobexp-aem-quickstart.ui.config</artifactId>
                            <type>zip</type>
                            <target>/apps/adobexp-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>io.wcm</groupId>
                            <artifactId>io.wcm.caconfig.editor</artifactId>
                            <target>/apps/adobexp-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>io.wcm</groupId>
                            <artifactId>io.wcm.caconfig.extensions</artifactId>
                            <target>/apps/adobexp-packages/application/install</target>
                        </embedded>
                    </embeddeds>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.day.jcr.vault</groupId>
                <artifactId>content-package-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <verbose>true</verbose>
                    <failOnError>true</failOnError>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- ====================================================================== -->
    <!-- P R O F I L E S                                                        -->
    <!-- ====================================================================== -->
    <profiles>
        <profile>
            <id>autoInstallSinglePackage</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.day.jcr.vault</groupId>
                        <artifactId>content-package-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>install-package</id>
                                <goals>
                                    <goal>install</goal>
                                </goals>
                                <configuration>
                                    <targetURL>http://${aem.host}:${aem.port}/crx/packmgr/service.jsp</targetURL>
                                    <failOnError>true</failOnError>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>autoInstallSinglePackagePublish</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.day.jcr.vault</groupId>
                        <artifactId>content-package-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>install-package-publish</id>
                                <goals>
                                    <goal>install</goal>
                                </goals>
                                <configuration>
                                    <targetURL>http://${aem.publish.host}:${aem.publish.port}/crx/packmgr/service.jsp</targetURL>
                                    <failOnError>true</failOnError>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Profile to upload the all package to GitHub Release -->
        <!-- This profile should ONLY be activated during release:perform when performRelease=true -->
        <profile>
            <id>github-release</id>
            <activation>
                <property>
                    <name>performRelease</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>de.jutzig</groupId>
                        <artifactId>github-release-plugin</artifactId>
                        <version>1.4.0</version>
                        <executions>
                            <execution>
                                <id>upload-to-github-release</id>
                                <phase>deploy</phase>
                                <goals>
                                    <goal>release</goal>
                                </goals>
                            </execution>
                        </executions>
                        <!-- Add missing dependency for Maven 3.9+ compatibility -->
                        <dependencies>
                            <dependency>
                                <groupId>org.codehaus.plexus</groupId>
                                <artifactId>plexus-utils</artifactId>
                                <version>3.5.1</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <!-- GitHub repository owner/name -->
                            <repositoryId>adobexp/aem</repositoryId>
                            <!-- Server ID for GitHub authentication (must match settings.xml) -->
                            <serverId>github-adobexp</serverId>
                            <!-- Use the release tag created by maven-release-plugin (matches tagNameFormat) -->
                            <tag>${project.artifactId}-${project.version}</tag>
                            <!-- Release name -->
                            <releaseName>AdobeXP AEM Quickstart ${project.version}</releaseName>
                            <!-- Release description -->
                            <description>AdobeXP AEM Quickstart All Package - Version ${project.version}</description>
                            <!-- The artifact file to upload -->
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>${project.artifactId}-${project.version}.zip</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <!-- Set to true if you want to overwrite existing assets -->
                            <overwriteArtifact>true</overwriteArtifact>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>com.adobexp</groupId>
            <artifactId>adobexp-aem-quickstart.ui.apps</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.adobexp</groupId>
            <artifactId>adobexp-aem-quickstart.ui.content</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.adobexp</groupId>
            <artifactId>adobexp-aem-quickstart.ui.config</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <!-- wcm.io Context-Aware Configuration Editor -->
        <dependency>
            <groupId>io.wcm</groupId>
            <artifactId>io.wcm.caconfig.editor</artifactId>
        </dependency>
        <dependency>
            <groupId>io.wcm</groupId>
            <artifactId>io.wcm.caconfig.extensions</artifactId>
        </dependency>
    </dependencies>
</project>